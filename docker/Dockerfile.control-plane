# DataFoundry control plane service image.
# Build context: repository root (docker build -f docker/Dockerfile.control-plane .)
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Terraform CLI pinned via .terraform-version (>= 1.9)
ARG TERRAFORM_VERSION=1.9.8
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates unzip \
    && curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" -o /tmp/terraform.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && rm /tmp/terraform.zip \
    && apt-get purge -y unzip && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY control-plane/ ./control-plane/
RUN pip install ./control-plane

EXPOSE 8000

HEALTHCHECK CMD curl -sf http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "datafoundry.controlplane.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
