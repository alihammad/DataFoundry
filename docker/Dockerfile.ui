# DataFoundry web UI image (feature 007).
# Build context: repository root (docker build -f docker/Dockerfile.ui .)
# Builds the SPA and serves it via the control plane (single artifact, R-01).
FROM node:22-alpine AS build

WORKDIR /app
COPY ui/package.json ui/package-lock.json* ./
RUN npm install
COPY ui/ ./
RUN npm run build

FROM python:3.12-slim AS runtime

WORKDIR /app
COPY control-plane/ ./control-plane/
RUN pip install ./control-plane
COPY --from=build /app/dist ./ui/dist

ENV DF_UI_STATIC_DIR=/app/ui/dist \
    DF_UI_BASE_PATH=/

EXPOSE 8000

CMD ["uvicorn", "datafoundry.controlplane.api.app:app", "--host", "0.0.0.0", "--port", "8000"]