# TFLint configuration — DataFoundry Terraform modules
config {
  format = "compact"
  module = true
}

plugin "aws" {
  enabled = true
  version = "0.33.0"
  source  = "github.com/terraform-linters/tflint-ruleset-aws"
}

plugin "google" {
  enabled = true
  version = "0.30.0"
  source  = "github.com/terraform-linters/tflint-ruleset-google"
}

rule "terraform_required_version" {
  enabled = true
}

rule "terraform_required_providers" {
  enabled = true
}

rule "terraform_standard_module_structure" {
  enabled = true
}

# Provider-isolated modules: forbid cross-provider references
rule "terraform_workspace_environment" {
  enabled = true
}
